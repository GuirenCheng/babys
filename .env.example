# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交到仓库）
# Linux/Mac:  cp .env.example .env
# Windows:     复制后重命名为 .env

# Django 密钥（生产环境务必更换为随机串）
SECRET_KEY=django-insecure-REPLACE-ME-IN-PRODUCTION

# MySQL 数据库密码（MySQL root 密码与各服务连接密码保持一致）
DB_PASSWORD=changeme

# 支付宝沙箱配置
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_SERVER_URL=https://openapi.alipaydev.com/gateway.do
# 多行 PEM 密钥用 \n 表示换行
ALIPAY_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR-PRIVATE-KEY\n-----END RSA PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYOUR-PUBLIC-KEY\n-----END PUBLIC KEY-----
